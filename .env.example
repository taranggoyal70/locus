# Required. Create a Clerk application and copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Controlled alpha. Only these comma-separated Clerk user IDs can start Agent Runs.
# An empty value disables new Agent Runs for everyone.
ALPHA_ALLOWED_USER_IDS=

# Required for public launch unless OPS_ALERT_WEBHOOK_URL is configured. The
# committed production-health workflow is the supported external monitor.
OPS_EXTERNAL_HEALTHCHECK=github_actions

# Agent model routing. A plain provider/model string uses Vercel AI Gateway.
# Vercel deployments authenticate with short-lived OIDC credentials, so no
# provider API key belongs in this application. The Agent also requests the
# Gateway's no-prompt-training policy for every model call.
# Catalog and pricing: https://vercel.com/ai-gateway/models
LOCUS_AGENT_MODEL=openai/gpt-5.6-sol

# Optional. A GitHub token raises the rate limit for the "paste a public repo"
# feature (the repo tree is read via the GitHub API). Locus works without it for
# small/medium public repos. Create one at https://github.com/settings/tokens
# (no scopes needed for public repos).
GITHUB_TOKEN=

# Supabase (required for persistence, API keys, analytics, and Agent Runs).
# For local dev, run `pnpm dlx supabase@2.111.0 start`, then
# `pnpm dlx supabase@2.111.0 db reset`, and copy values from
# `pnpm dlx supabase@2.111.0 status`. The committed Supabase config owns local
# ports and migration replay. For a hosted project, use the history-aware rollout
# docs instead of shell-looping migration files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authorizes the daily retention job configured in vercel.json.
CRON_SECRET=

# Optional HTTPS destination for launch-critical operational alerts. When this
# is configured it takes precedence over OPS_EXTERNAL_HEALTHCHECK in /api/health.
OPS_ALERT_WEBHOOK_URL=

# Public URLs (auto-detected on Vercel; set for local dev or self-hosting).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/taranggoyal70/locus
