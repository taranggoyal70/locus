<<<<<<< HEAD
# Invited design partners, as comma-separated Clerk user IDs. These accounts
# resolve to the `partner` Tier: 2 concurrent and 10 daily Agent Runs, comped, no
# billing surface. They are also the only accounts admitted while the Admission
# table is unreadable, which is why the allowlist still exists alongside
# self-serve.
ALPHA_ALLOWED_USER_IDS=

# Self-serve admission. Set to the exact word `open` to admit any signed-in
# account to the `free` Tier: 1 concurrent and 3 daily Agent Runs on public
# Repos, no private reads, no external delivery.
#
# Only `open` counts. "true", "1", "yes", and "on" are rejected, because this is
# the variable that exposes provider capacity to the public internet and those
# are the values a hurried edit produces by accident. Empty or absent keeps the
# deployment invite-only.
#
# Opening this does not release any capability. Individual capabilities are
# withheld by CAPABILITY_RELEASE in src/lib/admission.ts, which is code, not
# configuration, so widening access is always a reviewable commit.
LOCUS_SELF_SERVE=

# Maximum number of self-serve accounts this deployment will admit. Empty means
# no ceiling. This is the control that bounds spend: per-account Run quota bounds
# one account's cost and says nothing about how many accounts exist, and signup
# is free.
#
# `0` is not the same as empty. Zero admits nobody new while leaving every
# already-admitted account working, which is a soft pause that evicts nobody.
# A malformed value is rejected rather than treated as unlimited.
#
# Self-serve also requires a verified email address. That is not configurable:
# it is the barrier that makes creating a second account cost something.
LOCUS_SELF_SERVE_MAX_ACCOUNTS=
=======
# Optional invite list. These Clerk user IDs can start Agent Runs even when the
# public beta flag is off. Clear both settings to disable all new Runs.
ALPHA_ALLOWED_USER_IDS=

# Explicitly opens Agent Run starts to every signed-in user. Leave false until
# migrations 018-020 are applied and the frozen production canary passes.
LOCUS_PUBLIC_BETA_ENABLED=false
>>>>>>> 8982add (feat(ui): explain limited shared runs and Cloudflare setup)

# Required for public launch unless OPS_ALERT_WEBHOOK_URL is configured. The
# committed production-health workflow is the supported external monitor.
OPS_EXTERNAL_HEALTHCHECK=github_actions

# Reviewed recurring-free Agent route. The model value is fail-closed: changing
# it requires a reviewed code change, not a dashboard experiment.
LOCUS_AGENT_MODEL=@cf/qwen/qwen3.8-27b

# Shared Cloudflare Workers AI pool. Create a narrowly scoped Workers AI token:
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Encrypts user-owned Cloudflare tokens before persistence. Generate with
# `openssl rand -base64 32`. Never reuse a Clerk, Supabase, or provider secret.
LOCUS_CREDENTIAL_ENCRYPTION_KEY=

# Optional. A GitHub token raises the rate limit for the "paste a public repo"
# feature (the repo tree is read via the GitHub API). Locus works without it for
# small/medium public repos. Create one at https://github.com/settings/tokens
# (no scopes needed for public repos).
GITHUB_TOKEN=

# Supabase (required for persistence, API keys, analytics, and Agent Runs).
# For local dev, run `pnpm dlx supabase@2.111.0 start`, then
# `pnpm dlx supabase@2.111.0 db reset`, and copy values from
# `pnpm dlx supabase@2.111.0 status`. The committed Supabase config owns local
# ports and migration replay. For a hosted project, use the history-aware rollout
# docs instead of shell-looping migration files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authorizes the daily retention job configured in vercel.json.
CRON_SECRET=

# Optional HTTPS destination for launch-critical operational alerts. When this
# is configured it takes precedence over OPS_EXTERNAL_HEALTHCHECK in /api/health.
OPS_ALERT_WEBHOOK_URL=

# Public URLs (auto-detected on Vercel; set for local dev or self-hosting).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/taranggoyal70/locus
