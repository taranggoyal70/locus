# Required. Create a Clerk application and copy its API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. A GitHub token raises the rate limit for the "paste a public repo"
# feature (the repo tree is read via the GitHub API). Locus works without it for
# small/medium public repos. Create one at https://github.com/settings/tokens
# (no scopes needed for public repos).
GITHUB_TOKEN=

# Legacy OAuth cleanup only. New private-repository connections are disabled;
# keep these configured until every existing connection has been revoked.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (required for persistence, API keys, analytics).
# Create a project at https://supabase.com/dashboard and run every migration
# in supabase/migrations in numeric order.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional; retained for legacy subscription status, portal, and webhook
# handling while new Pro checkout is closed during the public beta).
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public URLs (auto-detected on Vercel; set for local dev or self-hosting).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/taranggoyal70/locus
