{
  "name": "locus",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "bin": {
    "locus": "bin/locus.mjs",
    "locus-mcp": "bin/mcp.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "check:alpha-claims": "node scripts/check-alpha-claims.mjs",
    "benchmark": "node scripts/benchmark.mjs --write",
    "eval:release1": "node scripts/release1-eval.mjs",
    "evidence:release1": "node scripts/release1-public-report.mjs",
    "evidence:release1:write": "node scripts/release1-public-report.mjs --write",
    "sync-cli": "cp bin/*.mjs cli/",
    "check-sync": "diff bin/core.mjs cli/core.mjs && diff bin/locus.mjs cli/locus.mjs && diff bin/mcp.mjs cli/mcp.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.41",
    "@clerk/nextjs": "7.5.17",
    "@supabase/supabase-js": "2.110.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/sandbox": "2.9.0",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.42",
    "mammoth": "1.12.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "22.3.1",
    "tesseract.js": "7.0.0",
    "unpdf": "1.6.2",
    "workflow": "4.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
