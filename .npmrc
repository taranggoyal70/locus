verify-deps-before-run=false

# R8 note: dependency lifecycle scripts are executable package code, not
# passive metadata. This repository does NOT set ignore-scripts, deliberately.
#
# pnpm 11 already blocks dependency lifecycle scripts by default, and
# pnpm-workspace.yaml narrows that further with an explicit
# onlyBuiltDependencies allowlist (@swc/core, esbuild, sharp, unrs-resolver).
# That allowlist is a strictly stronger control than a blanket flag: it names
# the exact packages permitted to execute at install time, so adding a fifth is
# a reviewable diff rather than a silent default.
#
# Setting ignore-scripts=true here would override that allowlist and break the
# native builds those four packages require. Keep the allowlist as the control.
